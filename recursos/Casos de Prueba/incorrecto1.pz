@modelo "claude-sonnet-4-6"
@formato "lista"
@destino "correo"

/* Este agente ayuda a planificar un viaje corto
   revisando presupuesto y actividades disponibles */

AGENTE planificador {
  contexto = "Eres un asistente de viajes"

  variable presupuesto = 1500&
  variable dias = 5

  PREGUNTAR "Que actividades recomiendas?" SOBRE presupuesto -> actividades #pendiente
  ANALIZAR actividades SOBRE "clima esperado" -> clima
  GENERAR itinerario DESDE actividades + clima -> plan $$

  RESUMIR plan EN 80 palabras -> resumen_plan?
  TRADUCIR resumen_plan EN "frances" -> version_francesa
}

AGENTE 2corrector {
  contexto = "Revisas errores de redaccion

  variable texto = version_francesa

  CLASIFICAR texto COMO "formal" -> tipo_texto
  EXTRAER texto SOBRE "nombres propios" -> nombres @@
}

EJECUTAR planificador
EJECUTAR 2corrector
EXPORTAR plan; resumen_plan
