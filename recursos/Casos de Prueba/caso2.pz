@modelo "claude-haiku-4-5"
@rol "asistente de redaccion"
@formato "texto plano"

// Agente que ayuda a resumir documentos largos
AGENTE redactor {
    contexto = "Eres un asistente experto en redaccion de documentos"
    variable documento = CARGAR("informe.txt")
    RESUMIR documento EN 200 palabras -> resumen_corto
    ANALIZAR documento SOBRE "claridad y coherencia" -> analisis
    TRADUCIR resumen_corto DESDE "espanol" -> resumen_ingles
    CLASIFICAR documento COMO "tecnico" -> categoria
    /* Este bloque de comentario explica que aqui
       se realiza la extraccion de datos relevantes
       del documento original */
    EXTRAER documento SOBRE "fechas importantes" -> fechas
}

EJECUTAR redactor
EXPORTAR resumen_corto, analisis, resumen_ingles, categoria, fechas