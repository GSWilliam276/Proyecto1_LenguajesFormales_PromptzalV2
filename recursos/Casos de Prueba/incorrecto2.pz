@modelo "claude-sonnet-4-6"
@rol "asistente de soporte

/* Este comentario de bloque se queda abierto a proposito
   para verificar que el analizador reporta el error y
   descarta el resto del archivo como parte del comentario

AGENTE soporte {
    contexto = "Ayudas a resolver tickets de soporte"
    variable ticket = CARGAR("ticket.txt")
    PREGUNTAR "Cual es la solucion?" SOBRE ticket -> solucion
}

EJECUTAR soporte
EXPORTAR solucion
