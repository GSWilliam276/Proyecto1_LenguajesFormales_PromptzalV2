@modelo "claude-sonnet-4-6"
@rol "asistente de finanzas personales"
@formato "markdown"

/*
  Caso intermedio: agrega numeros decimales, la flecha entre
  varios comandos encadenados, y un comentario de bloque,
  elementos que el caso simple no utiliza.
*/

AGENTE asesor {
    contexto = "Eres un asesor financiero conservador"
    variable ingreso = 8500.50
    variable ahorro_meta = 20.5

    ANALIZAR ingreso SOBRE "capacidad de ahorro" -> analisis
    GENERAR plan DESDE analisis -> propuesta
    CLASIFICAR propuesta COMO "conservador" -> categoria
}

EJECUTAR asesor
EXPORTAR propuesta, categoria
