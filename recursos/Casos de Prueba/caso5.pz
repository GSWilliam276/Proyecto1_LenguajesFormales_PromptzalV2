@modelo "claude-fable-5"
@rol "asistente de marketing"
@formato "markdown"

/* Este agente ayuda a generar contenido de marketing
   para campañas publicitarias de productos nuevos */
AGENTE mercadologo {
    contexto = "Eres un experto en marketing digital"
    variable producto = CARGAR("producto_nuevo.json")
    
    // Se genera el eslogan principal
    GENERAR eslogan DESDE "campaña para " + producto -> resultado_eslogan
    
    PREGUNTAR "Cual es el publico objetivo?" SOBRE producto -> publico
    RESUMIR publico EN 50 palabras -> publico_resumido
    
    variable precio = 29.99
    variable cantidad = 100
    
    ANALIZAR producto SOBRE "competencia en el mercado" -> analisis_mercado
    TRADUCIR eslogan DESDE "espanol" -> eslogan_ingles @ 
    CLASIFICAR producto COMO "electronico" -> categoria_producto
    EXTRAER producto SOBRE "caracteristicas tecnicas" -> caracteristicas
}

EJECUTAR mercadologo
EXPORTAR resultado_eslogan, publico_resumido, analisis_mercado, categoria_producto