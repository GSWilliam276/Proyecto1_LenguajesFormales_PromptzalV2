@modelo "claude-opus-5"

AGENTE revisor {
    contexto = "cadena sin cerrar de proposito
    variable dato1 = "otra cadena que tampoco cierra
    PREGUNTAR "esta si cierra bien" SOBRE dato1 -> resultado1
    variable dato2 = "una tercera cadena sin cerrar
    GENERAR texto DESDE "prueba final" -> resultado2
}

EJECUTAR revisor