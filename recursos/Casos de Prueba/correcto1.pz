@modelo "claude-sonnet-4-6"
@rol "asistente de analisis"
@formato "markdown"

/*
  Caso largo y valido, sin errores lexicos.
  Cubre las diez categorias de token del lenguaje: identificador,
  palabra reservada, comando de IA, conector, directiva, cadena,
  entero, decimal, operador y delimitador; ademas de comentarios
  de linea y de bloque, y el conector flecha.
*/

AGENTE analista {
  contexto = "Eres un analista de datos experto"

  variable ventas = CARGAR("ventas.csv")
  variable meta = 200
  variable margen = 15.5

  // Se generan las tendencias principales del archivo
  PREGUNTAR "Cuales son las tendencias?" SOBRE ventas -> tendencias
  ANALIZAR ventas SOBRE "margen de ganancia" -> hallazgos
  GENERAR reporte DESDE tendencias + hallazgos -> salida
  RESUMIR salida EN 50 palabras -> resumen
}

AGENTE redactor {
  contexto = "Eres un redactor creativo"

  variable tema = "inteligencia artificial en Guatemala"

  GENERAR articulo DESDE tema -> borrador
  RESUMIR borrador EN 100 palabras -> resumen_articulo
  TRADUCIR resumen_articulo DESDE "espanol" -> version_ingles
  CLASIFICAR borrador COMO "tecnologia" -> categoria
  EXTRAER borrador SOBRE "palabras clave" -> palabras_clave
}

EJECUTAR analista
EJECUTAR redactor
EXPORTAR salida, resumen, version_ingles, categoria, palabras_clave
