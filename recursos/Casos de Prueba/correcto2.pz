@modelo "claude-sonnet-4-6"
@rol "asistente de cocina"
@formato "texto plano"

// Agente simple que sugiere una receta rapida
AGENTE cocinero {
    contexto = "Eres un chef experto en comida rapida y saludable"
    variable ingredientes = CARGAR("despensa.csv")
    PREGUNTAR "Que puedo cocinar hoy?" SOBRE ingredientes -> receta
    RESUMIR receta EN 60 palabras -> resumen
}

EJECUTAR cocinero
EXPORTAR resumen
